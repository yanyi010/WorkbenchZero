{
  "id": "zero.ai",
  "name": "Quick Ask",
  "version": "0.1.0",
  "apiVersion": "1",
  "description": "AI assistant over any OpenAI-compatible endpoint (including local ones).",
  "publisher": "zero",
  "trust": "trusted",
  "permissions": ["network", "ai:invoke", "secrets:read", "clipboard:write"],
  "activationEvents": [
    "onCommand:zero.ai.quickAsk",
    "onCommand:zero.ai.open",
    "onView:zero.ai.chat",
    "onEvent:ai.quickAskText"
  ],
  "contributes": {
    "commands": [
      {
        "id": "zero.ai.quickAsk",
        "title": "Quick Ask",
        "category": "AI",
        "takesArgs": true
      },
      { "id": "zero.ai.open", "title": "Open Chat", "category": "AI", "opensView": "zero.ai.chat" }
    ],
    "views": [{ "id": "zero.ai.chat", "title": "Chat", "icon": "✦", "location": "main" }],
    "settings": [
      {
        "key": "zero.ai.baseUrl",
        "type": "string",
        "title": "Base URL",
        "description": "OpenAI-compatible endpoint, e.g. http://localhost:1234/v1",
        "default": ""
      },
      {
        "key": "zero.ai.model",
        "type": "string",
        "title": "Model ID",
        "description": "Manual entry — no built-in model list (spec §48).",
        "default": ""
      },
      {
        "key": "zero.ai.apiKeySecret",
        "type": "string",
        "title": "API key secret name",
        "description": "Name under which the API key is stored in the secrets vault. Leave empty for local endpoints.",
        "default": "zero.ai.apiKey"
      },
      {
        "key": "zero.ai.maxTokens",
        "type": "number",
        "title": "Max response tokens",
        "default": 2048
      }
    ],
    "searchProviders": [],
    "captureProviders": [
      { "id": "zero.ai.ask", "title": "Quick Ask", "prefixes": ["?"], "priority": 95, "command": "zero.ai.quickAsk" }
    ]
  }
}
