{
  "id": "eigendesk.tasks",
  "name": "Tasks",
  "version": "0.1.0",
  "apiVersion": "1",
  "description": "Lightweight task list: title, status, due date, priority, tags, project, notes.",
  "publisher": "eigendesk",
  "trust": "trusted",
  "permissions": ["workspace:read", "workspace:write", "notification"],
  "activationEvents": [
    "onCommand:eigendesk.tasks.quickAdd",
    "onCommand:eigendesk.tasks.open",
    "onView:eigendesk.tasks.main",
    "onStartup",
    "onEvent:workspace.opened",
    "onEvent:task.createFromText"
  ],
  "contributes": {
    "commands": [
      {
        "id": "eigendesk.tasks.quickAdd",
        "title": "Quick Add Task",
        "category": "Tasks",
        "takesArgs": true,
        "keybinding": "Ctrl+Alt+T"
      },
      { "id": "eigendesk.tasks.open", "title": "Open Tasks", "category": "Tasks", "opensView": "eigendesk.tasks.main" }
    ],
    "views": [{ "id": "eigendesk.tasks.main", "title": "Tasks", "icon": "✓", "location": "main" }],
    "widgets": [{ "id": "eigendesk.tasks.today", "title": "Today", "minWidth": 220, "minHeight": 140 }],
    "settings": [],
    "searchProviders": [{ "id": "eigendesk.tasks", "title": "Tasks" }],
    "captureProviders": [
      {
        "id": "eigendesk.tasks.quick",
        "title": "Task",
        "prefixes": ["/t", "task:"],
        "priority": 90,
        "command": "eigendesk.tasks.quickAdd"
      }
    ],
    "artifactTypes": [{ "type": "task", "title": "Task" }]
  }
}
