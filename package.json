{
  "name": "eigendesk-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/desktop",
    "plugins/*",
    "examples/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:app": "node scripts/build.mjs",
    "dev": "npm run tauri -w @eigendesk/desktop -- dev",
    "build:release": "npm run tauri -w @eigendesk/desktop -- build",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run -ws --if-present typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "wb": "node packages/devtools/bin/wb.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.2.3",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "jsdom": "^30.1.1",
    "marked": "^15.0.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
