{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EigenDesk",
  "version": "0.1.0",
  "identifier": "org.eigendesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../scripts/build.mjs && vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "EigenDesk",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first extensible personal workstation",
    "longDescription": "EigenDesk is a fast, local-first, extensible personal workstation for researchers, developers and power users. Almost all end-user functionality is a plugin; the kernel coordinates capabilities."
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4QjFEQjUzOUIxRUY5RDUKUldUVitSNmJVOXV4R0UvZjB6NmdzWGQrbGFFVTdFRlcyYnlvcTFENCtRYkE3ZHdVbVU5c1AvMDUK"
    }
  }
}
