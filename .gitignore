# Build outputs
node_modules/
target/
apps/desktop/src-tauri/gen/schemas/

# Vite/esbuild output — regenerated by `npm run build`. The tauri context
# macro needs apps/desktop/dist to exist at compile time, so a .gitkeep
# placeholder is tracked; all real build output stays ignored.
dist/
!apps/desktop/dist/
apps/desktop/dist/*
!apps/desktop/dist/.gitkeep

# Generated plugin bundles (rebuilt by scripts/build.mjs). The registry
# seed files are tracked so a fresh clone compiles and boots empty.
apps/desktop/src-tauri/resources/*
!apps/desktop/src-tauri/resources/registry/
apps/desktop/src-tauri/resources/registry/*
!apps/desktop/src-tauri/resources/registry/index.json
!apps/desktop/src-tauri/resources/packs.json
!apps/desktop/src-tauri/resources/plugins/
apps/desktop/src-tauri/resources/plugins/*
!apps/desktop/src-tauri/resources/plugins/.gitkeep

# Vite / vitest
coverage/
.vite/

# Workbench Zero runtime state (never commit workspaces or logs)
.workbench/
logs/
*.log

# Result artifacts from experiments / benchmarks
results/
result/

# OS
.DS_Store
Thumbs.db

# Updater private keys must never live in the repository
*.key
*.pem
